# UMove secrets. The easiest way to create .env is:  bash scripts/install.sh
# (or by hand: cp .env.example .env && nano .env && chmod 600 .env)
# Generate each password with:  openssl rand -base64 32 | tr -d '/+=' | head -c 40

# Database owner (used only for setup and backups)
POSTGRES_PASSWORD=

# Database account the app uses (read/write rows only, cannot change tables)
APP_DB_PASSWORD=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
TUNNEL_TOKEN=

# Google sign-in: Google Cloud Console > Google Auth Platform > Clients (see docs/SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared with the Cloudflare Worker (web). Put the SAME value in the Worker's
# secret PROXY_SECRET. At least 32 characters.
PROXY_SECRET=

# Who may open /admin (comma-separated Google emails)
ADMIN_EMAILS=

# From @BotFather (optional until runners go live)
TELEGRAM_BOT_TOKEN=

# The public address of UMove
PUBLIC_ORIGIN=https://umove.rafiarsya.com

# Requests per minute per visitor (anti-abuse; generous on purpose)
RATE_LIMIT_SITE=600
RATE_LIMIT_API=120

# Local port on the mini PC (127.0.0.1 only). Change it if 3100 is taken.
UMOVE_PORT=3100

# Optional e-mail: tells admins about new Runner/Driver applications and
# tells applicants the decision. Gmail: turn on 2-Step Verification, create an
# App Password (myaccount.google.com/apppasswords), then (@ written as %40):
# SMTP_URL=smtps://you%40gmail.com:abcdabcdabcdabcd@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
